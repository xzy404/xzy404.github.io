<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XPainting</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/font-awesome/css/font-awesome.min.css">
</head>
<body class="bg-slate-50 flex min-h-screen overflow-x-hidden m-0 p-0">

    <aside id="sidebar" class="fixed left-0 top-0 h-screen bg-white text-slate-800 z-50 transition-all duration-300 w-16 hover:w-64 group shadow-lg border-r border-slate-200/60 overflow-hidden flex flex-col justify-between">
        <div class="p-4 flex flex-col h-full">
            <a href="https://xzy404.github.io" class="text-3xl font-black tracking-wider block mb-10 font-mono text-teal-600 select-none pl-2">
                X<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-blue-600">Painting</span>
            </a>
            
            <nav class="space-y-2 flex-1">
                <a href="#/" id="nav-home" class="flex items-center space-x-4 px-3 py-3 rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-800 transition-all duration-200 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto">
                    <i class="fa-solid fa-house text-lg w-6 text-center"></i>
                    <span class="sidebar-text">公共画板</span>
                </a>
                <a href="#/draw" id="nav-draw" class="flex items-center space-x-4 px-3 py-3 rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-800 transition-all duration-200 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto">
                    <i class="fa-solid fa-palette text-lg w-6 text-center"></i>
                    <span class="sidebar-text">词条绘画区</span>
                </a>
                
                <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none group-hover:pointer-events-auto">
                    <hr class="border-slate-100 my-4">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider px-2 mb-2 whitespace-nowrap">往期展览</p>
                    <div class="space-y-1 max-h-60 overflow-y-auto px-1" id="past-terms-list">
                        </div>
                </div>
            </nav>
        </div>
    </aside>

    <main class="flex-1 pl-16 p-8 box-border transition-all duration-300" id="main-content">
        </main>

    <div id="lightbox" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-4 cursor-zoom-out" onclick="closeLightbox()">
        <img id="lightbox-img" class="max-w-full max-h-full rounded-xl shadow-2xl transition-transform duration-300" src="" alt="Zoomed View">
    </div>

    <script src="js/app.js"></script>

    <script src="https://fastly.jsdelivr.net/gh/stevenjoezhang/live2d-widget@latest/autoload.js"></script>

</body>
</html>
